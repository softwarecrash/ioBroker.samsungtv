{
    "name": "iobroker.samsungtv",
    "version": "0.0.28",
    "description": "Modern Samsung TV adapter with discovery and multi-device support",
    "author": "softwarecrash <dev/null@softwarecrash.de>",
    "contributors": [],
    "homepage": "https://github.com/softwarecrash/ioBroker.samsungtv",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "samsung",
        "samsung tv",
        "tizen",
        "upnp",
        "ssdp",
        "mdns",
        "wol"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/softwarecrash/ioBroker.samsungtv.git"
    },
    "engines": {
        "node": ">=22"
    },
    "main": "build/main.js",
    "files": [
        "admin/",
        "build/",
        "!build/**/*.map",
        "!build/**/*.test.*",
        "doc/",
        "scripts/",
        "io-package.json",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "@iobroker/dm-utils": "^3.2.1",
        "@iobroker/youtube-lounge": "^0.2.0",
        "bonjour-service": "^1.4.4",
        "fast-xml-parser": "^5.11.2",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/build-tools": "^3.0.3",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^6.3.0",
        "@tsconfig/node22": "^22.0.6",
        "@types/node": "^22.20.5",
        "@types/ws": "^8.18.2",
        "globals": "^17.13.0",
        "json5": "^2.2.3",
        "typescript": "~5.9.3"
    },
    "scripts": {
        "build": "npm run build:typescript && npm run build:admin",
        "build:typescript": "tsc -p tsconfig.build.json && node scripts/copy-encryption.js",
        "build:admin": "node tasks",
        "check": "tsc -p tsconfig.json --noEmit",
        "check:repository": "npm run clean && npx --yes @iobroker/repochecker@5.20.13 --local softwarecrash/ioBroker.samsungtv main",
        "clean": "clean-dir build && clean-dir coverage",
        "pretest": "npm run build:typescript",
        "test:unit": "node scripts/run-mocha.js --config test/mocharc.custom.json \"build/**/*.test.js\" --exit",
        "test:js": "node scripts/run-mocha.js --config test/mocharc.custom.json \"test/**/test!(PackageFiles|Startup).js\"",
        "test:package": "node scripts/run-mocha.js test/package --exit",
        "test:integration": "node scripts/run-mocha.js test/integration --exit",
        "test": "npm run test:unit && npm run test:js && npm run test:package",
        "lint": "eslint -c eslint.config.mjs .",
        "translate": "translate-adapter",
        "release": "release-script"
    }
}
