{
    "name": "iobroker.samsungtv",
    "version": "0.0.27",
    "description": "Modern Samsung TV adapter with discovery and multi-device support",
    "author": "softwarecrash",
    "contributors": [],
    "homepage": "https://github.com/softwarecrash/ioBroker.samsungtv",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "samsung",
        "samsung tv",
        "tizen",
        "upnp",
        "ssdp",
        "mdns",
        "wol"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/softwarecrash/ioBroker.samsungtv.git"
    },
    "engines": {
        "node": ">=22"
    },
    "main": "main.js",
    "files": [
        "admin/",
        "build/",
        "doc/",
        "lib/",
        "scripts/",
        "main.js",
        "io-package.json",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "bonjour-service": "^1.4.4",
        "fast-xml-parser": "^5.10.1",
        "wake_on_lan": "^1.0.0",
        "ws": "^8.21.2"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/adapter-react-v5": "^8.3.2",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^5.3.0",
        "@mui/icons-material": "^6.5.0",
        "@mui/material": "^6.5.0",
        "@tsconfig/node22": "^22.0.5",
        "@types/node": "^22.20.1",
        "@types/react": "^18.3.28",
        "@types/react-dom": "^18.3.7",
        "globals": "^17.9.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": "~5.9.3"
    },
    "scripts": {
        "build": "npm run build:typescript && npm run build:admin",
        "build:admin": "build-adapter react",
        "build:typescript": "tsc -p tsconfig.build.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "clean": "rm -rf build admin/build coverage",
        "pretest": "npm run build:typescript",
        "test:js": "node scripts/run-mocha.js --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
        "test:unit": "node scripts/run-mocha.js \"build/**/*.test.js\" --exit",
        "test:package": "node scripts/run-mocha.js test/package --exit",
        "test:integration": "node scripts/run-mocha.js test/integration --exit",
        "test": "npm run test:unit && npm run test:js && npm run test:package",
        "lint": "eslint -c eslint.config.mjs .",
        "release": "release-script"
    }
}
