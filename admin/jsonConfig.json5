{
    i18n: true,
    type: 'tabs',
    items: {
        settings: {
            type: 'panel',
            label: 'Configuration',
            items: {
                _intervalsHeader: {
                    type: 'header',
                    text: 'Intervals',
                    size: 4,
                    xs: 12,
                },
                autoScan: {
                    type: 'checkbox',
                    label: 'Auto scan',
                    default: true,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                autoScanInterval: {
                    type: 'number',
                    label: 'Auto scan interval',
                    unit: 'Seconds',
                    min: 30,
                    max: 86400,
                    step: 30,
                    default: 300,
                    disabled: '!data.autoScan',
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                pollInterval: {
                    type: 'number',
                    label: 'Poll interval',
                    unit: 'Seconds',
                    min: 10,
                    max: 3600,
                    step: 5,
                    default: 30,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                _networkHeader: {
                    type: 'header',
                    text: 'Network methods',
                    size: 4,
                    xs: 12,
                },
                discoveryTimeout: {
                    type: 'number',
                    label: 'Discovery timeout',
                    unit: 'Seconds',
                    min: 2,
                    max: 60,
                    step: 1,
                    default: 5,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                enableSsdp: {
                    type: 'checkbox',
                    label: 'Enable SSDP',
                    default: true,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                enableMdns: {
                    type: 'checkbox',
                    label: 'Enable mDNS',
                    default: true,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                enableWol: {
                    type: 'checkbox',
                    label: 'Enable Wake-on-LAN',
                    default: true,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                mdnsServices: {
                    type: 'text',
                    label: 'mDNS services',
                    expertMode: true,
                    xs: 12,
                    sm: 12,
                    md: 8,
                    lg: 8,
                    xl: 8,
                },
            },
        },
        devices: {
            type: 'panel',
            label: 'Device management',
            items: {
                _description: {
                    type: 'infoBox',
                    boxType: 'info',
                    text: 'Device management description',
                    xs: 12,
                },
                _manager: {
                    type: 'deviceManager',
                    smallCards: false,
                    xs: 12,
                    style: {
                        width: '100%',
                        minHeight: 480,
                    },
                },
            },
        },
        remote: {
            type: 'panel',
            label: 'Remote control',
            items: {
                _remoteControl: {
                    type: 'custom',
                    url: 'custom/customComponents.js',
                    name: 'ConfigCustomSamsungTvSet/Components/RemoteControlComponent',
                    i18n: true,
                    guiApi: 2,
                    bundlerType: 'module',
                    newLine: true,
                    xs: 12,
                    sm: 12,
                    md: 12,
                    lg: 12,
                    xl: 12,
                },
            },
        },
        scenes: {
            type: 'panel',
            label: 'Scenes',
            items: {
                _scenesHelp: {
                    type: 'infoBox',
                    boxType: 'info',
                    text: 'Scenes help',
                    xs: 12,
                },
                scenes: {
                    type: 'table',
                    noDelete: false,
                    xs: 12,
                    items: [
                        {
                            type: 'text',
                            attr: 'name',
                            title: 'Name',
                            width: '20%',
                            validator: '!!data.name && /^[^.]+$/.test(data.name)',
                            validatorNoSaveOnError: true,
                        },
                        {
                            type: 'selectSendTo',
                            attr: 'device',
                            title: 'TV',
                            width: '20%',
                            command: 'listDevices',
                            jsonData: '{"withAll": true}',
                            manual: false,
                        },
                        {
                            type: 'custom',
                            attr: 'steps',
                            title: 'Steps',
                            width: '45%',
                            url: 'custom/customComponents.js',
                            name: 'ConfigCustomSamsungTvSet/Components/SceneStepsComponent',
                            i18n: true,
                            guiApi: 2,
                            bundlerType: 'module',
                            validator: '!!data.steps',
                            validatorNoSaveOnError: true,
                        },
                        {
                            type: 'number',
                            attr: 'delay',
                            title: 'Pause between steps',
                            unit: 'ms',
                            width: '15%',
                            min: 0,
                            max: 60000,
                            step: 100,
                            default: 500,
                        },
                    ],
                },
            },
        },
    },
}
