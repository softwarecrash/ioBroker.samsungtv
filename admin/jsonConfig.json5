{
    i18n: true,
    type: 'tabs',
    items: {
        settings: {
            type: 'panel',
            label: 'Configuration',
            items: {
                _intervalsHeader: {
                    type: 'header',
                    text: 'Intervals',
                    size: 4,
                    xs: 12,
                },
                autoScan: {
                    type: 'checkbox',
                    label: 'Auto scan',
                    default: true,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                autoScanInterval: {
                    type: 'number',
                    label: 'Auto scan interval',
                    unit: 'Seconds',
                    min: 30,
                    max: 86400,
                    step: 30,
                    default: 300,
                    disabled: '!data.autoScan',
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                pollInterval: {
                    type: 'number',
                    label: 'Poll interval',
                    unit: 'Seconds',
                    min: 10,
                    max: 3600,
                    step: 5,
                    default: 30,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                _networkHeader: {
                    type: 'header',
                    text: 'Network methods',
                    size: 4,
                    xs: 12,
                },
                discoveryTimeout: {
                    type: 'number',
                    label: 'Discovery timeout',
                    unit: 'Seconds',
                    min: 2,
                    max: 60,
                    step: 1,
                    default: 5,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                enableSsdp: {
                    type: 'checkbox',
                    label: 'Enable SSDP',
                    default: true,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                enableMdns: {
                    type: 'checkbox',
                    label: 'Enable mDNS',
                    default: true,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                enableWol: {
                    type: 'checkbox',
                    label: 'Enable Wake-on-LAN',
                    default: true,
                    xs: 12,
                    sm: 6,
                    md: 4,
                    lg: 3,
                    xl: 3,
                },
                mdnsServices: {
                    type: 'text',
                    label: 'mDNS services',
                    expertMode: true,
                    xs: 12,
                    sm: 12,
                    md: 8,
                    lg: 8,
                    xl: 8,
                },
            },
        },
        devices: {
            type: 'panel',
            label: 'Device management',
            items: {
                _description: {
                    type: 'infoBox',
                    boxType: 'info',
                    text: 'Device management description',
                    xs: 12,
                },
                _manager: {
                    type: 'deviceManager',
                    smallCards: true,
                    xs: 12,
                    style: {
                        width: '100%',
                        minHeight: 480,
                    },
                },
            },
        },
    },
}
